# 复制本文件为 .env 并填入你自己的配置：cp .env.example .env
# 更方便的方式：运行 python3 backend/app.py，在网页左侧「模型配置」里填写，
# 会自动写回 .env（与命令行版共用）。
# 注意：.env 不要提交到 git（已写入 .gitignore）

# 必填：API key
LLM_API_KEY=

# 选填：以下三项为智谱 GLM 的默认值，用其他服务商时替换成对应地址和模型名
# 智谱 GLM:   https://open.bigmodel.cn/api/paas/v4/        模型如 glm-4-flash（免费）/ glm-4-plus
# DeepSeek:  https://api.deepseek.com/v1                  模型如 deepseek-chat
# Moonshot:  https://api.moonshot.cn/v1                   模型如 moonshot-v1-8k
# OpenAI:    https://api.openai.com/v1                    模型如 gpt-4o-mini
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# 若报 "SSL ... CERTIFICATE_VERIFY_FAILED"（python.org 官方安装版 Python 常见），
# 取消下一行注释，让 Python 使用 macOS 系统证书包：
# SSL_CERT_FILE=/etc/ssl/cert.pem

# 选填：日志文件路径（默认项目根目录 agent.log）与级别（默认 DEBUG，
# DEBUG 会把每轮发给 LLM 的完整 payload 和原始返回都记进去；改成 INFO 只记关键事件）
# LOG_FILE=/tmp/agent.log
# LOG_LEVEL=INFO

# 选填：Agent 的工作区目录（coding 工具的文件读写和命令执行都限制在这里，
# 默认是项目根目录下的 workspace/，也可在网页里随时切换）。不要指向重要数据目录。
# WORKSPACE_DIR=/Users/you/playground

# 选填：网页"上下文容量"显示用的窗口大小（token），按所用模型的实际窗口调整。
# 如 DeepSeek V4.1 为 1000000（100万），GLM-5.3 为 1000000
# CONTEXT_WINDOW=262144
