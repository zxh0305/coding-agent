.env
__pycache__/
*.pyc
.DS_Store
# 运行时数据统一收在 data/：数据库、artifacts（外置正文）、logs、backups
data/
# agent 记忆目录（WORKSPACE_DIR 指向项目根时会出现在项目根）
.agent-memory/
# agent 在用户工作区内的落盘目录：会话附件（attachments/）等运行时产物，
# 不进版本库——用户要求附件上传不得引起 git 工作区变动
.coding-agent/

# 真机评估脚本的一次性结果
backend/manual/eval_patch_*.json

# 压测脚本与压测数据播种：仅本地压测/优化用，不进版本库（用户要求）
backend/manual/stress_*.py
backend/manual/seed_render_fixtures.py

# pytest 试验残留（本项目用 unittest；目录已删，防再生成）
.pytest_cache/

# 会话绑定"未命名工作区"时 agent 的落盘目录（压测/试验产物，运行时生成）
workspace/
